{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/no-shell-edits.sh",
            "timeout": 5,
            "statusMessage": "Checking for shell-side file edits"
          }
        ]
      }
    ]
  }
}
