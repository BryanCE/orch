{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|TaskStop",
        "hooks": [
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/stay-on-task.sh" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/tasks-gate.sh" }
        ]
      }
    ]
  }
}
