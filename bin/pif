#!/usr/bin/env bash
# pif — launch pi's CLI under bun. Argument policy is NOT decided here.
#
# This wrapper exists for one reason: pi ships as a JS entrypoint that has to be
# located and handed to bun. Everything else — which extensions load, which tools
# are allowed, which model — is the pi adapter's to decide (src/adapters/pi.ts),
# and it passes those flags through verbatim. A second place choosing extensions
# is what registered orch's bridge twice and made pi reject every orch_* tool.
#
# Overrides:
#   PIF_CLI   path to pi-coding-agent cli.js

BUN="${BUN:-$(command -v bun || echo "$HOME/.bun/bin/bun")}"

CLI="${PIF_CLI:-}"
if [ -z "$CLI" ]; then
  for candidate in \
    "$HOME/.bun/install/global/node_modules/@earendil-works/pi-coding-agent/dist/cli.js" \
    "$HOME/.pi/npm-global/lib/node_modules/@earendil-works/pi-coding-agent/dist/cli.js"; do
    [ -f "$candidate" ] && CLI="$candidate" && break
  done
fi
if [ -z "$CLI" ]; then
  echo "pif: could not find pi-coding-agent cli.js (set PIF_CLI)" >&2
  exit 1
fi

exec "$BUN" "$CLI" "$@"
