{
  "name": "orch-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "check": "bun run --parallel --no-exit-on-error check:orch check:web",
    "check:orch": "bun --filter @bryance/orch check",
    "check:web": "bun --filter orch-web check",
    "test": "bun run test:orch",
    "test:orch": "bun --filter @bryance/orch test",
    "dev": "bun run dev:web",
    "dev:web": "bun --filter orch-web dev",
    "build": "bun run build:orch && bun run build:web",
    "build:orch": "bun --filter @bryance/orch build:cli",
    "build:orch:dev": "bun --filter @bryance/orch build:dev",
    "build:web": "bun --filter orch-web build",
    "db:gen": "bun --filter @bryance/orch db:gen",
    "db:gen:dry": "bun --filter @bryance/orch db:gen:dry",
    "db:mig": "bun --filter @bryance/orch db:mig",
    "db:check": "bun --filter @bryance/orch db:check",
    "db:reset": "bun --filter @bryance/orch db:reset",
    "db:reset:dry": "bun --filter @bryance/orch db:reset:dry",
    "reset": "bun --filter @bryance/orch reset",
    "reinstall": "bun --filter @bryance/orch reinstall",
    "fallow:dupes": "bunx fallow dupes --baseline .fallow-dupes-baseline.json --fail-on-issues",
    "fallow:health": "bunx fallow health --baseline .fallow-health-baseline.json --fail-on-issues",
    "fallow:dead": "bunx fallow dead-code",
    "fallow:accept": "bunx fallow dupes --save-baseline .fallow-dupes-baseline.json && bunx fallow health --save-baseline .fallow-health-baseline.json"
  },
  "devDependencies": {
    "fallow": "^3.20.0"
  },
  "trustedDependencies": [
    "@google/genai",
    "protobufjs"
  ]
}
